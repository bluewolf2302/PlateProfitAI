# Supabase PostgreSQL connection settings.
# Copy this file to .env or configure these values in your IDE/terminal.
# Never commit the populated file or share these values.
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-supabase-database-password>

# Optional Spring Boot HTTP port.
SERVER_PORT=8080

# Optional AI service URL used by the Spring Boot proxy.
AI_SERVICE_URL=http://localhost:8001
